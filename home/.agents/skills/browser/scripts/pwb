#!/usr/bin/env bash

# pwb — deterministic playwright-cli session wrapper.

set -o pipefail

err() {
  printf 'pwb: %s\n' "$*" >&2
}

die_usage() {
  err "$*"
  exit 2
}

die_runtime() {
  err "$*"
  exit 1
}

resolve_path() {
  if command -v realpath >/dev/null 2>&1; then
    realpath "$1"
    return
  fi

  if [ -L "$1" ]; then
    local target
    target=$(readlink "$1") || return 1
    case "$target" in
      /*) resolve_path "$target" ;;
      *) resolve_path "$(dirname "$1")/$target" ;;
    esac
    return
  fi

  (
    cd "$(dirname "$1")" || exit 1
    printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")"
  )
}

SELF=$(resolve_path "${BASH_SOURCE[0]}") || die_runtime "cannot resolve pwb path"
SKILL_DIR=$(cd "$(dirname "$SELF")/.." && pwd -P) \
  || die_runtime "cannot resolve skill directory"
PINS="$SKILL_DIR/scripts/pins"
LIB="$SKILL_DIR/scripts/lib.sh"

# shellcheck source=lib.sh disable=SC1091
. "$LIB" || die_runtime "missing lib: $LIB"
# shellcheck source=pins disable=SC1091
. "$PINS" || die_runtime "missing pins: $PINS"
: "${CLI_PIN:?missing CLI_PIN in $PINS}"
: "${CHROMIUM_REV:?missing CHROMIUM_REV in $PINS}"

usage() {
  cat <<'EOF'
Usage:
  pwb [help]                              show this help
  pwb help <cli-command>                  show playwright-cli help for one command
  pwb doctor                              check dependencies and pins
  pwb session [--json]                    show session and paths
  pwb status                              show whether the session is open
  pwb path <profile|output|root|config>   print one absolute path
  pwb open [url] [--headed] [--device=<p>|--mobile] [--restart]
  pwb close                               close the session
  pwb reset [--yes]                       remove the session root
  pwb <cli-command> [args...]             pass through with -s=<session>

Artifacts: screenshot/pdf take --filename=<path>; a positional argument is an
 element ref/selector, never a file path.
EOF
}

require_cache_base() {
  [ -n "${XDG_CACHE_HOME:-}" ] || [ -n "${HOME:-}" ] \
    || die_usage "HOME or XDG_CACHE_HOME is required"
}

cache_base() {
  printf '%s\n' "${XDG_CACHE_HOME:-$HOME/.cache}/pi-browser-v1"
}

hash_string() {
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$1" | sha256sum | cut -c1-12
  elif command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | cut -c1-12
  else
    return 1
  fi
}

resolve_cache_if_exists() {
  if [ -d "$C" ]; then
    C=$(cd "$C" && pwd -P) || die_runtime "cannot resolve cache directory: $C"
  fi
}

ensure_cache() {
  require_cache_base
  C=$(cache_base)
  mkdir -p "$C" || die_runtime "cannot create cache directory: $C"
  C=$(cd "$C" && pwd -P) || die_runtime "cannot resolve cache directory: $C"
}

compute_session() {
  require_cache_base
  C=$(cache_base)
  resolve_cache_if_exists

  if W=$(git -C . rev-parse --show-toplevel 2>/dev/null); then
    :
  else
    W=$(pwd -P) || die_runtime "cannot resolve current directory"
  fi
  [ -n "$W" ] || W=$(pwd -P) || die_runtime "cannot resolve current directory"

  local base h
  base=$(basename "$W")
  base=$(printf '%s' "$base" | tr '\n' '-')
  base=$(printf '%s' "$base" | sed 's/[^A-Za-z0-9._-]/-/g')
  base=$(printf '%s' "$base" | sed 's/^-*//; s/-*$//')
  if [ "${#base}" -gt 32 ]; then
    base=$(printf '%s' "$base" | cut -c1-32 | sed 's/-*$//')
  fi
  [ -n "$base" ] || base="workspace"

  h=$(hash_string "$W") || die_runtime "sha256sum or shasum is required"
  [ -n "$h" ] || die_runtime "sha256sum or shasum is required"

  S0="pi-${base}-${h}"
  if [ -n "${PWB_SESSION_SUFFIX:-}" ]; then
    case "$PWB_SESSION_SUFFIX" in
      *..*) die_usage "PWB_SESSION_SUFFIX must not contain '..'" ;;
      *[!A-Za-z0-9._-]*) die_usage "invalid PWB_SESSION_SUFFIX" ;;
      [A-Za-z0-9]*) ;;
      *) die_usage "invalid PWB_SESSION_SUFFIX" ;;
    esac
    if [ "${#PWB_SESSION_SUFFIX}" -gt 16 ]; then
      die_usage "invalid PWB_SESSION_SUFFIX"
    fi
    S="${S0}-${PWB_SESSION_SUFFIX}"
  else
    S="$S0"
  fi

  R="$C/$S"
}

ensure_layout() {
  umask 077
  mkdir -p "$R" "$R/profile" "$R/output" || die_runtime "cannot create session root: $R"
  chmod 700 "$R" "$R/profile" "$R/output" 2>/dev/null || true
}

write_config() {
  local tmp="$R/.config.json.tmp.$$"
  if ! jq -n --arg out "$R/output" \
    '{browser:{browserName:"chromium",launchOptions:{headless:true,channel:"chromium"}},outputDir:$out}' \
    >"$tmp"; then
    rm -f "$tmp"
    die_runtime "cannot write config: $R/config.json"
  fi
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$R/config.json" || die_runtime "cannot install config: $R/config.json"
  chmod 600 "$R/config.json" 2>/dev/null || true
}

scrub_env() {
  local name
  for name in $(env | sed -n 's/^\(PLAYWRIGHT_MCP_[A-Za-z0-9_]*\)=.*/\1/p'); do
    unset "$name"
  done
  unset PLAYWRIGHT_CLI_SESSION
}

is_live() {
  local out rc
  scrub_env
  out=$(playwright-cli list --all --json 2>/dev/null) || return 2
  printf '%s' "$out" | jq -e --arg s "$S" '.browsers[] | select(.name == $s)' >/dev/null 2>&1
  rc=$?
  case "$rc" in
    0) return 0 ;;
    1|4) return 1 ;;
    *) return 2 ;;
  esac
}

close_session_quiet() {
  playwright-cli -s="$S" close >/dev/null 2>&1 || true
}

session_cmd() {
  local json=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) json=1 ;;
      *) die_usage "session accepts only --json" ;;
    esac
    shift
  done

  ensure_cache
  compute_session
  ensure_layout

  if [ "$json" -eq 1 ]; then
    jq -n \
      --arg session "$S" \
      --arg workspace "$W" \
      --arg root "$R" \
      --arg profile "$R/profile" \
      --arg output "$R/output" \
      --arg config "$R/config.json" \
      '{session:$session,workspace:$workspace,root:$root,profile:$profile,output:$output,config:$config}'
  else
    printf 'session: %s\n' "$S"
    printf 'workspace: %s\n' "$W"
    printf 'root: %s\n' "$R"
    printf 'profile: %s\n' "$R/profile"
    printf 'output: %s\n' "$R/output"
    printf 'config: %s\n' "$R/config.json"
  fi
}

path_cmd() {
  [ "$#" -eq 1 ] || die_usage "path requires profile, output, root, or config"

  ensure_cache
  compute_session
  ensure_layout

  case "$1" in
    profile) printf '%s\n' "$R/profile" ;;
    output) printf '%s\n' "$R/output" ;;
    root) printf '%s\n' "$R" ;;
    config) printf '%s\n' "$R/config.json" ;;
    *) die_usage "path requires profile, output, root, or config" ;;
  esac
}

reserved_open_arg() {
  case "$1" in
    -s|--session|--config|--profile|--persistent|--user-data-dir|\
    --browser|--cdp|--endpoint|--extension|--executable-path|--channel)
      return 0
      ;;
    -s=*|--session=*|--config=*|--profile=*|--persistent=*|--user-data-dir=*|\
    --browser=*|--cdp=*|--endpoint=*|--extension=*|--executable-path=*|--channel=*)
      return 0
      ;;
  esac
  return 1
}

config_snippet() {
  printf '%s' "$1" | tr '\n' ' ' | cut -c1-200
}

json_block() {
  awk '/^\{/{p=1} p && /^### /{exit} p'
}

verify_config() {
  local raw errf errtxt out bad hint rc
  errf="$R/.config-print.stderr.$$"
  raw=$(playwright-cli -s="$S" config-print 2>"$errf")
  rc=$?
  errtxt=$(cat "$errf" 2>/dev/null) || errtxt=""
  rm -f "$errf"
  hint=$(config_snippet "${errtxt:+$errtxt }$raw")

  if [ "$rc" -ne 0 ]; then
    close_session_quiet
    err "config-print failed; session closed${hint:+ ($hint)}"
    return 1
  fi

  out=$(printf '%s\n' "$raw" | json_block)
  if [ -z "$out" ]; then
    close_session_quiet
    err "config-print returned no JSON; session closed${hint:+ ($hint)}"
    return 1
  fi

  if ! bad=$(printf '%s\n' "$out" | jq -r \
    --arg profile "$R/profile" \
    --arg output "$R/output" \
    --argjson headed "$headed" '
      [
        (if (.browser.browserName // "") != "chromium"
         then "browser.browserName" else empty end),
        (if (((.browser.launchOptions // {}).channel // "chromium") | tostring) != "chromium"
         then "browser.launchOptions.channel" else empty end),
        (if ((.browser.launchOptions // {}) | has("executablePath"))
         then "browser.launchOptions.executablePath" else empty end),
        (if ((.browser // {}) | has("cdpEndpoint"))
         then "browser.cdpEndpoint" else empty end),
        (if ((.browser // {}) | has("remoteEndpoint"))
         then "browser.remoteEndpoint" else empty end),
        (if (has("extension")) then "extension" else empty end),
        (if (.browser.userDataDir // "") != $profile
         then "browser.userDataDir" else empty end),
        (if (.outputDir // "") != $output
         then "outputDir" else empty end),
        (if $headed == 1 then
           (if ((.browser.launchOptions // {}).headless) != false
            then "browser.launchOptions.headless" else empty end)
         else
           (if ((.browser.launchOptions // {}).headless) != true
            then "browser.launchOptions.headless" else empty end)
         end)
      ] | .[]' 2>/dev/null); then
    close_session_quiet
    err "config-print returned invalid JSON; session closed${hint:+ ($hint)}"
    return 1
  fi

  if [ -n "$bad" ]; then
    close_session_quiet
    err "config drift: $(printf '%s' "$bad" | tr '\n' ' ')"
    err "global config: ${HOME:-}/.playwright/cli.config.json"
    return 1
  fi
  return 0
}

open_cmd() {
  local rest=()
  local headed=0
  local restart=0
  local timeout

  while [ "$#" -gt 0 ]; do
    if reserved_open_arg "$1"; then
      die_usage "reserved argument: $1"
    fi
    case "$1" in
      --headed)
        headed=1
        rest+=("$1")
        shift
        ;;
      --restart)
        restart=1
        shift
        ;;
      --device)
        rest+=("$1")
        shift
        if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
          rest+=("$1")
          shift
        fi
        ;;
      --device=*|--mobile)
        rest+=("$1")
        shift
        ;;
      *)
        rest+=("$1")
        shift
        ;;
    esac
  done

  if [ "${PWB_IDLE_TIMEOUT_MS+set}" = "set" ]; then
    case "$PWB_IDLE_TIMEOUT_MS" in
      ''|*[!0-9]*) die_usage "PWB_IDLE_TIMEOUT_MS must be numeric" ;;
    esac
    timeout="$PWB_IDLE_TIMEOUT_MS"
  elif [ "$headed" -eq 1 ]; then
    timeout=900000
  else
    timeout=3600000
  fi

  ensure_cache
  compute_session
  ensure_layout

  is_live
  live=$?
  [ "$live" -eq 2 ] && die_runtime "cannot query sessions with 'playwright-cli list --all --json'"
  if [ "$live" -eq 0 ] && [ "$restart" -eq 0 ]; then
    die_runtime "session $S is open; use 'pwb goto <url>' to continue, 'pwb open --restart' to restart"
  fi

  write_config
  scrub_env

  # Buffer the CLI's success output until config verification passes:
  # a verified session is the only thing pwb may announce as open.
  local open_out status
  open_out=$(playwright-cli -s="$S" open "${rest[@]}" \
    --config="$R/config.json" \
    --profile="$R/profile" \
    --idle-timeout="$timeout")
  status=$?
  if [ "$status" -ne 0 ]; then
    [ -z "$open_out" ] || printf '%s\n' "$open_out"
    exit 1
  fi

  verify_config || exit 1
  [ -z "$open_out" ] || printf '%s\n' "$open_out"
}

close_wait() {
  scrub_env
  playwright-cli -s="$S" close >/dev/null 2>&1 || true

  local poll_count poll_interval i=0 live
  poll_count="${PWB_CLOSE_POLL_COUNT:-30}"
  poll_interval="${PWB_CLOSE_POLL_INTERVAL:-0.5}"

  case "$poll_count" in
    ''|*[!0-9]*) die_usage "PWB_CLOSE_POLL_COUNT must be a non-negative integer" ;;
  esac
  case "$poll_interval" in
    ''|*[!0-9.]*) die_usage "PWB_CLOSE_POLL_INTERVAL must be numeric seconds" ;;
    *.*.*) die_usage "PWB_CLOSE_POLL_INTERVAL must be numeric seconds" ;;
    .*) die_usage "PWB_CLOSE_POLL_INTERVAL must be numeric seconds" ;;
  esac

  while [ "$i" -lt "$poll_count" ]; do
    is_live
    live=$?
    case "$live" in
      1) return 0 ;;
      2) return 2 ;;
    esac
    sleep "$poll_interval"
    i=$((i + 1))
  done

  return 1
}

close_cmd() {
  compute_session

  local live rc
  is_live
  live=$?
  case "$live" in
    2) die_runtime "cannot query sessions with 'playwright-cli list --all --json'" ;;
    1)
      jq -n --arg session "$S" '{session:$session,status:"not-open"}'
      exit 0
      ;;
  esac

  close_wait
  rc=$?
  case "$rc" in
    0) ;;
    2) die_runtime "cannot query sessions with 'playwright-cli list --all --json'" ;;
    *) die_runtime "session $S is still live after close; run 'pwb close' again or inspect with 'playwright-cli list --all --json'" ;;
  esac

  jq -n --arg session "$S" '{session:$session,status:"closed"}'
}

status_cmd() {
  [ "$#" -eq 0 ] || die_usage "status accepts no arguments"

  compute_session

  local live
  is_live
  live=$?
  case "$live" in
    2) die_runtime "cannot query sessions with 'playwright-cli list --all --json'" ;;
    0) jq -n --arg session "$S" '{session:$session,status:"open"}' ;;
    *) jq -n --arg session "$S" '{session:$session,status:"not-open"}' ;;
  esac
  exit 0
}

reset_cmd() {
  local yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1 ;;
      *) die_usage "reset accepts only --yes" ;;
    esac
    shift
  done

  compute_session

  if [ "$yes" -ne 1 ]; then
    err "refusing to remove $R; re-run with 'pwb reset --yes'"
    exit 1
  fi

  local live
  is_live
  live=$?
  case "$live" in
    2) die_runtime "cannot query sessions with 'playwright-cli list --all --json'" ;;
    0)
      close_wait || die_runtime "session $S is still live; refusing to remove $R"
      ;;
  esac

  case "$R" in
    "$C"/pi-*) ;;
    *) die_runtime "refusing to remove path outside the session cache: $R" ;;
  esac
  [ ! -L "$R" ] || die_runtime "refusing to remove symlinked session root: $R"

  if [ ! -e "$R" ]; then
    jq -n --arg session "$S" '{session:$session,status:"absent"}'
    exit 0
  fi

  rm -rf "$R" || die_runtime "cannot remove session root: $R"
  [ ! -e "$R" ] || die_runtime "session root still exists: $R"
  jq -n --arg session "$S" '{session:$session,status:"removed"}'
}

chromium_info() {
  local out
  out=$(playwright-cli install-browser chromium --dry-run 2>/dev/null) || return 1
  rev=$(printf '%s\n' "$out" \
    | sed -n 's/.*(playwright chromium v\([0-9][0-9]*\)).*/\1/p' | head -n 1)
  location=$(printf '%s\n' "$out" \
    | sed -n 's/.*Install location:[[:space:]]*//p' | head -n 1)
  [ -n "$rev" ] && [ -n "$location" ]
}

doctor() {
  local failures=0
  local rev location version

  fail() {
    printf 'fail: %s\n' "$*"
    failures=$((failures + 1))
  }

  if command -v jq >/dev/null 2>&1; then
    printf 'ok: jq\n'
  else
    fail "jq is required"
  fi

  if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then
    printf 'ok: hash\n'
  else
    fail "sha256sum or shasum is required"
  fi

  if command -v playwright-cli >/dev/null 2>&1; then
    version=$(cli_version)
    if [ "$version" = "$CLI_PIN" ]; then
      printf 'ok: playwright-cli version %s\n' "$version"
    else
      fail "playwright-cli version ${version:-unknown}, expected $CLI_PIN; run scripts/install --deps"
    fi

    if chromium_info; then
      if [ "$rev" != "$CHROMIUM_REV" ]; then
        fail "playwright-cli bundles chromium v$rev, pins say v$CHROMIUM_REV; update scripts/pins"
      elif [ ! -d "$location" ] || [ ! -e "$location/INSTALLATION_COMPLETE" ]; then
        fail "chromium v$rev not installed at $location; run scripts/install --deps"
      else
        printf 'ok: chromium v%s\n' "$rev"
      fi
    else
      fail "chromium dry-run failed; run scripts/install --deps"
    fi
  else
    fail "playwright-cli is required; run scripts/install --deps"
  fi

  if env | grep -q '^PLAYWRIGHT_MCP_'; then
    printf 'warn: PLAYWRIGHT_MCP_* is set in the caller environment\n'
  fi

  if [ -n "${HOME:-}" ] && [ -e "$HOME/.playwright/cli.config.json" ]; then
    printf 'warn: global config exists: %s\n' "$HOME/.playwright/cli.config.json"
  fi

  if command -v pwb >/dev/null 2>&1; then
    printf 'ok: pwb on PATH: %s\n' "$(command -v pwb)"
  else
    printf 'warn: pwb not on PATH; use %s\n' "$SELF"
  fi

  if [ "$failures" -eq 0 ]; then
    compute_session
    printf 'session: %s\n' "$S"
    printf 'root: %s\n' "$R"
    return 0
  fi

  return 1
}

path_like_token() {
  local lower

  case "$1" in
    http://*|https://*|data:*|about:*|file://*|blob:*) return 1 ;;
  esac
  case "$1" in
    /*|./*|../*|~/*) return 0 ;;
  esac
  # Selector metacharacters win: let upstream parse these as selectors.
  case "$1" in
    *'['*|*']'*|*'('*|*')'*|*'='*|*'"'*|*"'"*|*'>'*|*'#'*) return 1 ;;
  esac

  lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    *.png|*.jpg|*.jpeg|*.webp|*.pdf) return 0 ;;
  esac
  case "$1" in
    */*) return 0 ;;
  esac
  return 1
}

guard_artifact_args() {
  local cmd="$1"
  shift
  local arg p filename
  local positional=()

  while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
      --filename)
        shift
        [ "$#" -gt 0 ] || die_usage "--filename requires a value"
        filename="$1"
        case "$filename" in
          /*) ;;
          *) die_usage "--filename must be absolute; use \"\$(pwb path output)/name.ext\"" ;;
        esac
        shift
        continue
        ;;
      --filename=*)
        filename=${arg#--filename=}
        case "$filename" in
          /*) ;;
          *) die_usage "--filename must be absolute; use \"\$(pwb path output)/name.ext\"" ;;
        esac
        shift
        continue
        ;;
      --type)
        shift
        [ "$#" -gt 0 ] || die_usage "--type requires a value"
        shift
        continue
        ;;
      --type=*)
        shift
        continue
        ;;
      --*)
        shift
        continue
        ;;
      *)
        positional+=("$arg")
        shift
        ;;
    esac
  done

  for p in "${positional[@]}"; do
    case "$cmd" in
      screenshot)
        if path_like_token "$p"; then
          die_usage "screenshot [target] is an element ref/selector; for a file path use --filename=<path>"
        fi
        ;;
      pdf)
        die_usage "pdf takes no positional arguments; for a file path use --filename=<path>"
        ;;
    esac
  done
}

pass_through() {
  local gflags=()
  local cmd

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --)
        shift
        [ "$#" -gt 0 ] || die_usage "missing command"
        cmd="$1"
        shift
        break
        ;;
      -s|--session)
        die_usage "reserved argument: $1"
        ;;
      --session=*|-s=*)
        die_usage "reserved argument: $1"
        ;;
      -*)
        gflags+=("$1")
        shift
        ;;
      *)
        cmd="$1"
        shift
        break
        ;;
    esac
  done

  [ -n "${cmd:-}" ] || die_usage "missing command"

  case "$cmd" in
    open|close)
      die_runtime "use 'pwb $cmd' instead of passing '$cmd' through"
      ;;
    attach)
      die_runtime "'attach' is blocked; use the web-browser extension"
      ;;
    close-all|kill-all)
      die_runtime "'$cmd' is blocked; use 'pwb close' for this session"
      ;;
    delete-data)
      die_runtime "'delete-data' is blocked; use 'pwb reset --yes'"
      ;;
    install)
      die_runtime "'install' is blocked; use scripts/install --deps"
      ;;
    list)
      die_runtime "'list' is blocked; do not inspect other sessions"
      ;;
    playwright-cli)
      case "${1:-}" in
        list) die_runtime "'playwright-cli list' is blocked; do not inspect other sessions" ;;
      esac
      ;;
  esac

  case "$cmd" in
    screenshot|pdf) guard_artifact_args "$cmd" "$@" ;;
  esac

  compute_session
  case "$cmd" in
    screenshot|pdf) ;;
    *)
      is_live
      case "$?" in
        2) die_runtime "cannot query sessions with 'playwright-cli list --all --json'" ;;
        1) die_runtime "session $S is not open; run 'pwb open <url>'" ;;
      esac
      ;;
  esac

  scrub_env
  exec playwright-cli "${gflags[@]}" -s="$S" "$cmd" "$@"
}

main() {
  case "${1:-}" in
    ''|-h|--help)
      usage
      exit 0
      ;;
    help)
      shift
      [ "$#" -le 1 ] || die_usage "help accepts at most one cli-command"
      if [ "$#" -eq 0 ]; then
        usage
        exit 0
      fi
      case "$1" in
        doctor|session|status|path|open|close|reset|help)
          usage
          exit 0
          ;;
      esac
      exec playwright-cli --help "$1"
      ;;
    doctor)
      shift
      [ "$#" -eq 0 ] || die_usage "doctor accepts no arguments"
      doctor
      ;;
    session)
      shift
      session_cmd "$@"
      ;;
    status)
      shift
      status_cmd "$@"
      ;;
    path)
      shift
      path_cmd "$@"
      ;;
    open)
      shift
      open_cmd "$@"
      ;;
    close)
      shift
      [ "$#" -eq 0 ] || die_usage "close accepts no arguments"
      close_cmd
      ;;
    reset)
      shift
      reset_cmd "$@"
      ;;
    *)
      pass_through "$@"
      ;;
  esac
}

main "$@"
